# AtlasAI Python AI service environment configuration
# Copy this file to .env and replace placeholder values before running the AI backend.
# These variables are intended for the future Python/FastAPI recommendation and planning service.

# Service
APP_NAME=atlasai-ai
APP_ENV=development
PORT=8001
HOST=0.0.0.0

# API / integration
# Used to allow the AI service to receive app requests and talk to other core services.
API_BASE_URL=http://localhost:8001
AUTH_SERVICE_URL=http://localhost:4000

# Data layer
# Used for model metadata, embeddings, recommendation state, and temporary working datasets.
DATABASE_URL=postgresql://atlasai:atlasai@localhost:5432/atlasai
REDIS_URL=redis://localhost:6379
VECTOR_DB_URL=http://localhost:6333

# Model configuration
# Used to select the active provider and model for inference and scoring.
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0.4
MAX_TOKENS=800

# AI provider keys
# Never commit real secrets. Replace these with secure keys configured in a local environment.
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_API_KEY=your_google_api_key
OLLAMA_BASE_URL=http://localhost:11434

# Recommendation settings
# Used for personalization logic and trip-planning heuristics.
RECOMMENDATION_TOP_K=10
PERSONALIZATION_ENABLED=true
TRIP_OPTIMIZATION_ENABLED=true

# Logging and debugging
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false
