# AtlasAI Node.js API environment configuration
# Copy this file to .env and replace placeholder values before running the backend.
# These variables are for the future Node.js service that handles app logic and APIs.

# Server
PORT=4000
NODE_ENV=development
API_NAME=atlasai-api
CLIENT_ORIGIN=http://localhost:5173

# Database
# Used for application data, user records, trip fixtures, and persisted planning state.
DATABASE_URL=postgresql://atlasai:atlasai@localhost:5432/atlasai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atlasai
DB_USER=atlasai
DB_PASSWORD=your_database_password

# Cache / session data
# Used to improve performance and support brief session/token cache operations.
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace_with_secure_random_string

# Authentication
# Used to sign and verify user tokens and protect secured routes.
JWT_SECRET=replace_with_secure_random_string
JWT_EXPIRES_IN=7d
AUTH_ISSUER=http://localhost:4000
AUTH_AUDIENCE=atlasai-client
AUTH_JWKS_URL=http://localhost:4000/.well-known/jwks.json

# AI service integration
# Used to communicate with the Python AI service for recommendations and trip intelligence.
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=10000

# External service providers
# Values here will be consumed by integration layers for maps, travel data, or booking services.
TRAVEL_PROVIDER_API_BASE_URL=https://api.example.com
TRAVEL_PROVIDER_API_KEY=your_provider_api_key
MAPS_API_KEY=your_maps_api_key

# Logging and diagnostics
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
