# AtlasAI Mobile App environment configuration
# Copy this file to .env.local or your preferred Expo environment file and replace placeholders.
# These variables are intended for the future React Native mobile application.

# App metadata
EXPO_PUBLIC_APP_NAME=AtlasAI
EXPO_PUBLIC_APP_ENV=development

# API connectivity
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_AI_SERVICE_URL=http://localhost:8001

# Authentication
# Used for OAuth, session management, and protected user flows in the mobile client.
EXPO_PUBLIC_AUTH_PROVIDER=custom
EXPO_PUBLIC_AUTH_CLIENT_ID=your_mobile_oauth_client_id
EXPO_PUBLIC_AUTH_REDIRECT_URI=atlasai://auth/callback
EXPO_PUBLIC_AUTH_ISSUER=http://localhost:4000

# External integrations
# Used for location-aware trip planning and map features on mobile devices.
EXPO_PUBLIC_MAPS_API_KEY=your_maps_api_key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# App behavior
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=false
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
