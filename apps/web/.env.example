# AtlasAI Web App environment configuration
# Copy this file to .env.local (git-ignored) and adjust values for your machine.
#
# SECURITY: every VITE_-prefixed variable is bundled into the public browser build.
# Never put secrets here — no MongoDB connection strings, no private API keys.
# The web app talks to the backend API only.

# App metadata
VITE_APP_NAME=AtlasAI
VITE_APP_ENV=development

# API connectivity
# Leave empty to use same-origin requests: in development Vite proxies /api to
# VITE_API_PROXY_TARGET below. Set an absolute URL for deployed environments, e.g.
# VITE_API_BASE_URL=https://api.atlasai.example.com
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:4000

# Feature flags
VITE_ENABLE_TRIP_RECOMMENDATIONS=false
