# AtlasAI Web App environment configuration
# Copy this file to .env.local or a project-specific .env file and replace placeholder values.
# These variables are intended for the future React web application.

# App metadata
VITE_APP_NAME=AtlasAI
VITE_APP_ENV=development

# API connectivity
VITE_API_BASE_URL=http://localhost:4000
VITE_AI_SERVICE_URL=http://localhost:8001

# Authentication
# Used for frontend auth flows and token/session integration.
VITE_AUTH_PROVIDER=custom
VITE_AUTH_CLIENT_ID=your_oauth_client_id
VITE_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# External integrations
# Used when the frontend needs to call third-party travel, map, or analytics providers.
VITE_MAPS_API_BASE_URL=https://maps.example.com
VITE_ANALYTICS_ENABLED=false

# Feature flags
VITE_ENABLE_TRIP_RECOMMENDATIONS=false
VITE_ENABLE_OFFLINE_MODE=false
